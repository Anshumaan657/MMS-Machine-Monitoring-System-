# Phase 8 requires values issued by 3D for a dedicated read-only account.
# Do not place production credentials in this file or commit a real .env file.
MMS_DB_READ_ONLY=true
MMS_DB_TECHNOLOGY=
MMS_DB_HOST=
MMS_DB_PORT=
MMS_DB_NAME=
MMS_DB_USERNAME=
MMS_DB_PASSWORD=
MMS_DB_SSL=true

# Optional Phase 11 server-side management-summary narration.
# Keep the key server-side. The dashboard uses a deterministic verified summary
# whenever the key is absent or the AI response fails evidence validation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
